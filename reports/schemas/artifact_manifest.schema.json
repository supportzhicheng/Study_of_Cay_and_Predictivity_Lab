{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P10 report artifact manifest",
  "type": "object",
  "required": ["generated_at", "git_commit", "artifacts"],
  "properties": {
    "generated_at": {"type": "string"},
    "git_commit": {"type": "string"},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "sha256", "source_dependencies"],
        "properties": {
          "id": {"type": "string"},
          "path": {"type": "string"},
          "sha256": {"type": "string"},
          "source_dependencies": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
